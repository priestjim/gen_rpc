%%% -*-mode:erlang;coding:utf-8;tab-width:4;c-basic-offset:4;indent-tabs-mode:()-*-
%%% ex: set ft=erlang fenc=utf-8 sts=4 ts=4 sw=4 et:
%%%

Coveralls = {coveralls, {git, "https://github.com/markusn/coveralls-erl", {branch, "master"}}},

%% Coverage reporting is only enabled in GitHub Actions
case os:getenv("GITHUB_ACTIONS") of
  "true" ->
    Token = os:getenv("COVERALLS_REPO_TOKEN"),
    CONFIG1 = lists:keystore(coveralls_repo_token, 1, CONFIG, {coveralls_repo_token, Token}),
    lists:keystore(plugins, 1, CONFIG1, {plugins, [rebar3_hex, Coveralls]});
  _ ->
    CONFIG
end.
